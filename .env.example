# Provider ưu tiên, phân cách bằng dấu phẩy. Khi Gemini quota/rate-limit sẽ tự chuyển sang DeepSeek.
AI_PROVIDER_ORDER=gemini,deepseek

# Provider mặc định cũ (giữ lại để tương thích; AI_PROVIDER_ORDER được ưu tiên)
AI_PROVIDER=deepseek

# Đặt model tương ứng nếu muốn ghi đè model mặc định.
AI_MODEL=deepseek-chat
GEMINI_MODEL=gemini-3.6-flash
DEEPSEEK_MODEL=deepseek-chat

# Chỉ điền key của provider đang dùng. KHÔNG commit file .env.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# Context gửi đến provider ngoài chỉ là các mệnh đề đã chuẩn hoá trong citation registry,
# không phải transcript/chatlog thô. Chỉ đổi thành true sau khi đã rà soát registry cục bộ.
ALLOW_EXTERNAL_AI_CONTEXT=true

# Server cục bộ cho CP3
PORT=3000
